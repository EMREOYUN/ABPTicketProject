      "Türkçe"
    ],
    "defaultLanguage": "English",
    "createCommand": "abp new ABPTicketProject -t app --ui-framework angular --database-provider mongodb --theme leptonx-lite --skip-migration  --without-cms-kit --dont-run-bundling --no-social-logins -no-gdpr -no-openiddict-admin-ui -no-audit-logging -no-file-management -no-language-management -no-text-template-management"
